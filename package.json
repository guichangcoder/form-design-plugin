{
  "name": "form-design-plugin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "飞书多维表格表单设计插件：主子表联动录入、必填控制、条件显示",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 8848 --host",
    "test:regression": "esbuild tests/regression.entry.mjs --bundle --platform=node --format=esm --outfile=tests/regression.bundle.mjs --log-level=error && node tests/regression.bundle.mjs"
  },
  "dependencies": {
    "@douyinfe/semi-foundation": "^2.103.0",
    "@douyinfe/semi-icons": "^2.103.0",
    "@douyinfe/semi-ui": "^2.103.0",
    "@lark-base-open/js-sdk": "^1.0.2",
    "i18next": "^23.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  }
}
